# Core
AUV_MODE=AUTONOMOUS
AUV_LOG_LEVEL=INFO

# API (set host=0.0.0.0 on Raspberry Pi for LAN access)
AUV_API_HOST=127.0.0.1
AUV_API_PORT=8000

# LLM (Ollama)
AUV_USE_LLM=false
AUV_LLM_PROVIDER=OLLAMA
AUV_OLLAMA_URL=http://127.0.0.1:11434
AUV_OLLAMA_MODEL=phi4-mini
AUV_OLLAMA_TIMEOUT_S=30

# LLM (OpenAI-compatible local server: vLLM/TGI/llama.cpp server/etc.)
# Set AUV_LLM_PROVIDER=OPENAI_COMPAT to use these.
AUV_OPENAI_COMPAT_URL=http://127.0.0.1:8001
AUV_OPENAI_COMPAT_MODEL=local-model
AUV_OPENAI_COMPAT_API_KEY=
AUV_OPENAI_COMPAT_TIMEOUT_S=30

# LLM (llama.cpp in-process GGUF; fully offline, no server)
# Install: `pip install -e .[local-llm]`
# Set AUV_LLM_PROVIDER=LLAMA_CPP to use these.
AUV_LLAMA_CPP_MODEL_PATH=
AUV_LLAMA_CPP_N_CTX=2048
AUV_LLAMA_CPP_N_THREADS=
AUV_LLAMA_CPP_N_GPU_LAYERS=0
AUV_LLAMA_CPP_TEMPERATURE=0.2

# Safety limits (example defaults)
AUV_MAX_DEPTH_M=20
AUV_MIN_BATTERY_V=10.8

# Telemetry
AUV_TELEMETRY_DIR=.telemetry
AUV_TELEMETRY_FLUSH_INTERVAL_S=0.5
AUV_TELEMETRY_MAX_QUEUE=10000

# Control loop cadence (seconds)
AUV_TICK_SAFE_S=0.2
AUV_TICK_MANUAL_S=0.05
AUV_TICK_AUTONOMOUS_S=0.1

# Bound decision latency (seconds). If set and LLM fallback is enabled,
# slow LLM decisions fall back to Rules.
# Leave blank to disable.
AUV_DECISION_TIMEOUT_S=

# Bound I/O latency (seconds). If set, slow I/O times out (forced SAFE).
# Leave blank to disable.
AUV_SENSOR_READ_TIMEOUT_S=
AUV_THRUSTER_APPLY_TIMEOUT_S=
AUV_EXPERIMENT_APPLY_TIMEOUT_S=

# LLM autonomy robustness (fallback to rules)
AUV_LLM_FALLBACK_ENABLED=true
AUV_LLM_MAX_CONSECUTIVE_FAILURES=3
AUV_LLM_FAILURE_COOLDOWN_S=5

# Optional profiling (writes occasional {type:"profile"} telemetry events)
AUV_PROFILE_ENABLED=false
AUV_PROFILE_EVERY_N=50

# Hardware profile
# SIM | RASPI_STUB
AUV_HARDWARE=SIM

# 4-motor mixing
# VECTORED_4_HORIZONTAL (surge+sway+yaw) | H2_V2 (surge+heave+yaw)
AUV_THRUSTER_LAYOUT=VECTORED_4_HORIZONTAL
AUV_MOTOR_INVERT_0=false
AUV_MOTOR_INVERT_1=false
AUV_MOTOR_INVERT_2=false
AUV_MOTOR_INVERT_3=false

# Direct ESC PWM (Raspberry Pi GPIO)
# Keep disabled until you've verified pin mapping and ESC calibration.
AUV_PWM_ENABLED=false
AUV_MOTOR_GPIO_0=
AUV_MOTOR_GPIO_1=
AUV_MOTOR_GPIO_2=
AUV_MOTOR_GPIO_3=

# ESC pulse config (seconds)
AUV_ESC_MIN_PULSE_S=0.001
AUV_ESC_MAX_PULSE_S=0.002
AUV_ESC_FRAME_S=0.02
